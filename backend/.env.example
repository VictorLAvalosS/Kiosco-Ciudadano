# Plantilla de variables de entorno del backend.
# Copia este archivo como `.env` y rellena los valores reales.
# NUNCA subas el archivo `.env` al repositorio ni escribas credenciales en el código.

# Cadena de conexión a PostgreSQL (Supabase).
# Formato general (el controlador DEBE ser psycopg2):
#   postgresql+psycopg2://USUARIO:CONTRASENA@HOST:PUERTO/BASEDEDATOS
# Recomendado (IPv4 · Session pooler de Supabase, el host directo `db.<ref>...` es IPv6):
#   postgresql+psycopg2://postgres.<project-ref>:CONTRASENA@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Origen permitido para CORS (frontend de Vite en desarrollo).
CORS_ORIGINS=http://localhost:5173

# Nombre de usuario por defecto del equipo que etiqueta (opcional).
ETIQUETADOR_POR_DEFECTO=
